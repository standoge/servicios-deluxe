<!DOCTYPE html>
<html lang="es">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>{{titulo}} - Sistema de Conductores</title>
	<link rel="stylesheet" href="/conductores/form/form.css" />
</head>
<body>
	<div class="container">

		<div class="header">
			<h1>{{titulo}}</h1>
			<p>Complete todos los campos para {{#if conductor.driver_id}}actualizar{{else}}registrar{{/if}} el conductor.</p>
		</div>

		<form id="conductorForm" action="{{accion}}" method="POST" class="form-container">

			<fieldset class="form-section">
				<legend><span class="section-icon">🧍‍♂️</span> Información Personal</legend>
				<div class="form-grid">

					<div class="form-group">
						<label for="name" class="required">Nombres</label>
						<input type="text" id="nombre" name="name" value="{{conductor.name}}" required />
					</div>

					<div class="form-group">
						<label for="lastname" class="required">Apellidos</label>
						<input type="text" id="apellido" name="lastname" value="{{conductor.lastname}}" required />
					</div>

					<div class="form-group">
						<label for="dui" class="required">DUI</label>
						<input type="text" id="dui" name="dui" value="{{conductor.dui}}" placeholder="000000000" required />
					</div>

					<div class="form-group">
						<label for="phone">Teléfono</label>
						<input type="text" id="telefono" name="phone" value="{{conductor.phone}}" placeholder="00000000" />
					</div>

					<div class="form-group">
						<label for="driver_id" class="required">No. de Licencia</label>
						<input type="text" id="licencia" name="driver_id" value="{{conductor.driver_id}}" required {{#if conductor.driver_id}} disabled {{/if}}/>
					</div>

					<div class="form-group">
						<label for="license" class="required">Tipo de Licencia</label>
						<select id="tipoLicencia" name="license" required>
							<option value="">Seleccione tipo</option>
							<option value="Liviana" {{#if (eq conductor.license "Liviana")}}selected{{/if}}>Liviana</option>
							<option value="Pesada" {{#if (eq conductor.license "Pesada")}}selected{{/if}}>Pesada</option>
							<option value="Motocicleta" {{#if (eq conductor.license "Motocicleta")}}selected{{/if}}>Motocicleta</option>
						</select>
					</div>

				</div>
			</fieldset>

			<fieldset class="form-section">
				<legend><span class="section-icon">🚌</span> Información Laboral</legend>
				<div class="form-grid">

					<div class="form-group">
						<label for="start_date" class="required">Fecha de Contratación</label>
						<input type="date" id="fechaContratacion" name="start_date" value="{{conductor.start_date}}" required />
					</div>

					<div class="form-group">
						<label for="active">Estado</label>
						<select id="estado" name="active">
							<option value="true" {{#if (eq conductor.active "true")}}selected{{/if}}>Activo</option>
							<option value="false" {{#if (eq conductor.active "false")}}selected{{/if}}>Inactivo</option>
						</select>
					</div>

					<div class="form-group form-full">
						<label for="comment">Observaciones</label>
						<textarea id="observaciones" name="comment" rows="3">{{conductor.comment}}</textarea>
					</div>

				</div>
			</fieldset>

			<!-- Botones de Acción -->
			<div class="form-actions">
				<button type="button" class="btn btn-secondary" id="goBackToList">
					<span class="btn-icon">←</span> Regresar
				</button>

				<button type="submit" class="btn btn-primary" id="submitBtn">
					<span class="btn-icon">💾</span>
					{{#if conductor.id}}Actualizar Conductor{{else}}Guardar Conductor{{/if}}
				</button>
			</div>

			<script>
				document.addEventListener('DOMContentLoaded', function () {
					const goBackBtn = document.getElementById('goBackToList');
					if (goBackBtn) {
						goBackBtn.addEventListener('click', function () {
							window.location.href = 'http://localhost:3000/conductores/list/';
						});
					}
				});
			</script>

		</form>

		<!-- Modal de confirmación -->
		<div id="confirmModal" class="modal" style="display: none;">
			<div class="modal-content">
				<div class="modal-header">
					<h3>Confirmar Acción</h3>
					<span class="modal-close">&times;</span>
				</div>
				<div class="modal-body">
					<p id="confirmMessage">¿Está seguro de que desea guardar este conductor?</p>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" id="cancelConfirm">Cancelar</button>
					<button type="button" class="btn btn-primary" id="confirmSubmit">Confirmar</button>
				</div>
			</div>
		</div>

		<!-- Overlay de carga -->
		<div id="loadingOverlay" class="loading-overlay" style="display: none;">
			<div class="loading-spinner">
				<div class="spinner"></div>
				<p>Guardando conductor...</p>
			</div>
		</div>
	</div>

	<script src="/conductores/form/form.js"></script>
</body>
</html>





