<style>
    .table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 1.5rem;
        background: #fff;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        border-radius: 8px;
        overflow: hidden;
        margin-left: auto;
        margin-right: auto;
    }
    .table th, .table td {
        padding: 0.75rem 1rem;
        text-align: center;
        border-bottom: 1px solid #e9ecef;
        vertical-align: middle;
    }
    .table th {
        background: #f8f9fa;
        font-weight: 600;
        color: #343a40;
    }
    .table tr:hover {
        background: #e3f2fd;
        transition: background 0.2s;
    }
    .btn {
        padding: 0.4rem 0.8rem;
        border: none;
        border-radius: 4px;
        text-decoration: none;
        color: #fff;
        background: #007bff;
        font-size: 0.95rem;
        cursor: pointer;
        transition: background 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 0.3em;
    }
    .btn-success {
        background: #28a745;
        margin-bottom: 1rem;
        display: inline-block;
    }
    .btn-primary {
        background: #007bff;
    }
    .btn-warning {
        background: #ffc107;
        color: #343a40;
    }
    .btn-danger {
        background: #dc3545;
    }
    .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 2rem;
    }
</style>
    {{> navbar }}
    <div class="container">
        <div class="header">
            <h1>🧑‍✈️ Conductores Registrados</h1>
            <p>Gestión de personal conductor</p>
        </div>

        <div class="controls">
                <a href="http://localhost:3000/conductores/form/add" class="btn btn-success">
    ➕ Nuevo Conductor
</a>

            </div>
        </div>

        <div class="listado-conductores">
            <table id="conductoresTable" class="table">
                <thead>
                    <tr>
                        <th onclick="sortTable(0)">Licencia </th>
                        <th onclick="sortTable(1)">Nombre </th>
                        <th onclick="sortTable(2)">Apellido </th>
                        <th onclick="sortTable(3)">DUI </th>
                        <th onclick="sortTable(4)">Activo </th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each conductores}}
                    <tr onclick="verConductor({{this.driver_id}})" style="cursor:pointer;">
                        <td>{{this.driver_id}}</td>
                        <td>{{this.name}}</td>
                        <td>{{this.lastname}}</td>
                        <td>{{this.dui}}</td>
                        <td>{{this.active}}</td>
                        <td>
                            <a href="/conductores/form/{{this.driver_id}}" class="btn btn-primary" title="Editar">
                                <span aria-hidden="true">&#9998;</span> Editar
                            </a>
                            <button type="button" class="btn btn-danger btn-delete-driver" data-id="{{this.driver_id}}" title="Eliminar">
                                <span aria-hidden="true">&#128465;</span> Desactivar
                            </button>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Datos JSON para interacción JS -->
    <script id="conductoresData" type="application/json">
        {{{conductoresJSON}}}
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Función para ordenar tabla
            function sortTable(columnIndex) {
                const table = document.getElementById("conductoresTable");
                let switching = true;
                let dir = "asc"; // Dirección inicial ascendente
                let switchcount = 0;

                while (switching) {
                    switching = false;
                    let rows = table.rows;

                    for (let i = 1; i < (rows.length - 1); i++) {
                        let shouldSwitch = false;
                        let x = rows[i].getElementsByTagName("TD")[columnIndex];
                        let y = rows[i + 1].getElementsByTagName("TD")[columnIndex];
                        let xContent = x.textContent.toLowerCase();
                        let yContent = y.textContent.toLowerCase();

                        if (dir === "asc") {
                            if (xContent > yContent) {
                                shouldSwitch = true;
                                break;
                            }
                        } else if (dir === "desc") {
                            if (xContent < yContent) {
                                shouldSwitch = true;
                                break;
                            }
                        }
                    }

                    if (shouldSwitch) {
                        rows[i].parentNode.insertBefore(rows[i + 1], rows[i]);
                        switching = true;
                        switchcount++;
                    } else {
                        if (switchcount === 0 && dir === "asc") {
                            dir = "desc";
                            switching = true;
                        }
                    }
                }
            }

            // Función para ver detalle del conductor
            function verConductor(id) {
                window.location.href = `/conductores/form/${id}`;
            }

            // Agregar listener para filtrar tabla por estado
            document.getElementById('estadoFilter').addEventListener('change', function () {
                const filterValue = this.value.toLowerCase();
                const table = document.getElementById('conductoresTable');
                const trs = table.tBodies[0].rows;

                for (let row of trs) {
                    const estado = row.cells[4].textContent.toLowerCase();
                    if (filterValue === '' || estado === filterValue) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                }
            });

            // Exponer funciones globalmente para onclick inline
            window.sortTable = sortTable;
            window.verConductor = verConductor;
        });
    </script>

    <script src="/conductores/list/list.js"></script>





