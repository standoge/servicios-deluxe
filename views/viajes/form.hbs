<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{titulo}} - Sistema de Viajes</title>
    <link rel="stylesheet" href="/services/form/form.css">
</head>

<body>
    {{> navbar }}

    <div class="container">
        <!-- Header -->
        <div class="header">
            <h1>{{titulo}}</h1>
            <p>Complete todos los campos requeridos para {{#if viaje.id}}actualizar{{else}}registrar{{/if}} el viaje</p>
        </div>

        <!-- Formulario -->
        <div class="form-container">
            <form id="viajeForm" action="{{accion}}" method="POST">

                <!-- Botones de Acción -->
                <div class="form-actions">
                    <a href="/viajes/list" class="btn btn-secondary" id="goBackToList">
                        <span class="btn-icon">←</span>
                        Cancelar
                    </a>

                    <button type="submit" class="btn btn-primary" id="submitBtn">
                        <span class="btn-icon">💾</span>
                        {{#if viaje.id}}Actualizar Viaje{{else}}Guardar Viaje{{/if}}
                    </button>
                </div>

                <!-- Información del Cliente -->
                <div class="form-section">
                    <h3 class="section-title">
                        <span class="section-icon">👤</span>
                        Información del Cliente
                    </h3>

                    <div class="form-grid">
                        <div class="form-group">
                            <label for="customer_id" class="required">Cliente</label>
                            <select id="customer_id" name="customer_id" required>
                                <option value="">Seleccione un cliente</option>
                                <option value="nuevo">➕ Nuevo Cliente</option>
                                {{#each clientes}}
                                <option value="{{this.customer_id}}" {{#if (eq this.customer_id
                                    ../viaje.customer_id)}}selected{{/if}}>
                                    {{this.name}} {{this.lastname}} - {{this.dui}}
                                </option>
                                {{/each}}
                            </select>
                        </div>

                        <!-- Campos para nuevo cliente (se muestran dinámicamente) -->
                        <div id="nuevoClienteFields" style="display: none;" class="form-grid full-width">
                            <div class="form-group">
                                <label for="nuevo_cliente_nombre">Nombre Completo</label>
                                <input type="text" id="nuevo_cliente_nombre" name="nuevo_cliente[nombre]">
                            </div>
                            <div class="form-group">
                                <label for="cliente_id">Identificación</label>
                                <input type="text" id="cliente_id" name="nuevo_cliente[identificacion]">
                            </div>
                            <div class="form-group">
                                <label for="nuevo_cliente_telefono">Teléfono</label>
                                <input type="text" id="nuevo_cliente_telefono" name="nuevo_cliente[telefono]">
                            </div>
                            <div class="form-group">
                                <label for="nuevo_cliente_email">Email</label>
                                <input type="email" id="nuevo_cliente_email" name="nuevo_cliente[email]">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Información del Vehículo -->
                <div class="form-section">
                    <h3 class="section-title">
                        <span class="section-icon">🚗</span>
                        Información del Vehículo
                    </h3>

                    <div class="form-group">
                        <label for="vehiculo_id" class="required">Vehículo</label>
                        <select id="vehiculo_id" name="vehicle_id" required>
                            <option value="">Seleccione un vehículo</option>
                            {{#each vehiculos}}
                            <option value="{{this.vehicle_id}}" {{#if (eq this.vehicle_id
                                ../viaje.vehicle_id)}}selected{{/if}}>
                                {{this.placa}} - {{this.marca}} {{this.modelo}} ({{this.anio}})
                            </option>
                            {{/each}}
                        </select>
                    </div>
                </div>

                <!-- Información del Viaje -->
                <div class="form-section">
                    <h3 class="section-title">
                        <span class="section-icon">📍</span>
                        Información del Viaje
                    </h3>

                    <div class="form-grid">
                        <div class="form-group">
                            <label for="origen" class="required">Origen</label>
                            <input type="text" id="origen" name="origen" value="{{viaje.origen}}"
                                placeholder="Dirección o lugar de origen" required>
                        </div>

                        <div class="form-group">
                            <label for="destino" class="required">Destino</label>
                            <input type="text" id="destino" name="destino" value="{{viaje.destino}}"
                                placeholder="Dirección o lugar de destino" required>
                        </div>

                        <div class="form-group">
                            <label for="fecha_salida" class="required">Fecha de Salida</label>
                            <input type="datetime-local" id="fecha_salida" name="fecha_salida"
                                value="{{viaje.fecha_salida}}" required>
                        </div>

                        <div class="form-group">
                            <label for="fecha_regreso">Fecha de Regreso</label>
                            <input type="datetime-local" id="fecha_regreso" name="fecha_regreso"
                                value="{{viaje.fecha_regreso}}">
                        </div>

                        <div class="form-group">
                            <label for="estado" class="required">Estado</label>
                            <select id="estado" name="estado" required>
                                <option value="programado" {{#if (eq viaje.estado "programado" )}}selected{{/if}}>
                                    Programado</option>
                                <option value="en_progreso" {{#if (eq viaje.estado "en_progreso" )}}selected{{/if}}>En
                                    progreso</option>
                                <option value="completado" {{#if (eq viaje.estado "completado" )}}selected{{/if}}>
                                    Completado</option>
                                <option value="cancelado" {{#if (eq viaje.estado "cancelado" )}}selected{{/if}}>
                                    Cancelado</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="costo" class="required">Costo ($)</label>
                            <input type="string" id="costo" name="costo" value="{{viaje.costo}}" min="0" step="0.01"
                                placeholder="0.00" required>
                        </div>
                    </div>
                </div>

                <!-- Detalles Adicionales -->
                <div class="form-section">
                    <h3 class="section-title">
                        <span class="section-icon">📝</span>
                        Detalles Adicionales
                    </h3>

                    <div class="form-grid full-width">
                        <div class="form-group">
                            <label for="observaciones">Observaciones</label>
                            <textarea id="observaciones" name="observaciones" rows="3"
                                placeholder="Observaciones adicionales sobre el viaje...">{{viaje.observaciones}}</textarea>
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <!-- Modal de Confirmación -->
        <div id="confirmModal" class="modal">
            <div class="modal-content">
                <div class="modal-header">
                    <h3>Confirmar Acción</h3>
                    <span class="modal-close">&times;</span>
                </div>
                <div class="modal-body">
                    <p id="confirmMessage">¿Está seguro de que desea guardar este servicio?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" id="cancelConfirm">Cancelar</button>
                    <button type="button" class="btn btn-primary" id="confirmSubmit">Confirmar</button>
                </div>
            </div>
        </div>

        <!-- Loading Overlay -->
        <div id="loadingOverlay" class="loading-overlay">
            <div class="loading-spinner">
                <div class="spinner"></div>
                <p>Guardando servicio...</p>
            </div>
        </div>
    </div>

    <script src="/services/form/form.js"></script>
</body>

</html>