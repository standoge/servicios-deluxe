{{> navbar }}

<head>
    <link rel="stylesheet" href="/services/form/form.css">
</head>

<div class="container">
    <!-- Header -->
    <div class="header">
        <h1>{{titulo}}</h1>
        <p>Complete todos los campos requeridos para {{#if servicio.id}}actualizar{{else}}registrar{{/if}} el servicio</p>
    </div>
                
    <!-- Formulario -->
    <div class="form-container">
        <form id="servicioForm" action="{{accion}}" method="POST">
            <!-- Botones de Acción -->
            <div class="form-actions">
                <button type="button" class="btn btn-secondary" id="goBackToList">
                    <span class="btn-icon">←</span>
                    Cancelar
                </button>
                <button type="submit" class="btn btn-primary" id="submitBtn">
                    <span class="btn-icon">💾</span>
                    {{#if servicio.id}}Actualizar Servicio{{else}}Guardar Servicio{{/if}}
                </button>
            </div>

            <!-- Información del Servicio -->
            <div class="form-section">
                <h3 class="section-title">
                    <span class="section-icon">🔧</span>
                    Información del Servicio
                </h3>
                
                <div class="form-grid">
                    <!-- Tipo de Servicio -->
                    <div class="form-group">
                        <label for="tipo_servicio" class="required">Tipo de Servicio</label>
                        <select id="tipo_servicio" name="tipo_servicio" required>
                            <option value="">Seleccione el tipo de servicio</option>
                            <option value="Entrega de producto" {{#if (eq servicio.tipo_servicio "Entrega de producto")}}selected{{/if}}>Entrega de producto</option>
                            <option value="Viaje programado" {{#if (eq servicio.tipo_servicio "Viaje programado")}}selected{{/if}}>Viaje programado</option>
                            <option value="Viaje urgente" {{#if (eq servicio.tipo_servicio "Viaje urgente")}}selected{{/if}}>Viaje urgente</option>
                            <option value="Viaje" {{#if (eq servicio.tipo_servicio "Viaje")}}selected{{/if}}>Viaje</option>
                            <option value="Otro" {{#if (eq servicio.tipo_servicio "Otro")}}selected{{/if}}>Otro</option>
                        </select>
                    </div>

                    <!-- Estado -->
                    <div class="form-group">
                        <label for="estado" class="required">Estado</label>
                        <select id="estado" name="estado" required>
                            <option value="">Seleccione...</option>
                            <option value="programado" {{#if (eq servicio.estado "programado")}}selected{{/if}}>Programado</option>
                            <option value="urgente" {{#if (eq servicio.estado "urgente")}}selected{{/if}}>Urgente</option>
                            <option value="completado" {{#if (eq servicio.estado "completado")}}selected{{/if}}>Completado</option>
                        </select>
                    </div>

                    <!-- Fecha del Servicio -->
                    <div class="form-group">
                        <label for="fecha_servicio" class="required">Fecha del Servicio</label>
                        <input 
                            type="date" 
                            id="fecha_servicio" 
                            name="fecha_servicio" 
                            value="{{servicio.fecha_servicio}}"
                            required
                        >
                    </div>

                    <!-- Hora del Servicio -->
                    <div class="form-group">
                        <label for="hora_servicio" class="required">Hora del Servicio</label>
                        <input 
                            type="time" 
                            id="hora_servicio" 
                            name="hora_servicio" 
                            value="{{servicio.hora_servicio}}"
                            required
                        >
                    </div>

                    <!-- Duración Estimada -->
                    <div class="form-group">
                        <label for="duracion_estimada">Duración Estimada</label>
                        <select id="duracion_estimada" name="duracion_estimada">
                            <option value="">Seleccione duración</option>
                            <option value="0.5 horas" {{#if (eq servicio.duracion_estimada "0.5 horas")}}selected{{/if}}>30 minutos</option>
                            <option value="1 hora" {{#if (eq servicio.duracion_estimada "1 hora")}}selected{{/if}}>1 hora</option>
                            <option value="1.5 horas" {{#if (eq servicio.duracion_estimada "1.5 horas")}}selected{{/if}}>1.5 horas</option>
                            <option value="2 horas" {{#if (eq servicio.duracion_estimada "2 horas")}}selected{{/if}}>2 horas</option>
                            <option value="3 horas" {{#if (eq servicio.duracion_estimada "3 horas")}}selected{{/if}}>3 horas</option>
                            <option value="4 horas" {{#if (eq servicio.duracion_estimada "4 horas")}}selected{{/if}}>4 horas</option>
                            <option value="Todo el día" {{#if (eq servicio.duracion_estimada "Todo el día")}}selected{{/if}}>Todo el día</option>
                        </select>
                    </div>

                    <!-- Costo -->
                    <div class="form-group">
                        <label for="costo" class="required">Costo ($)</label>
                        <input 
                            type="number" 
                            id="costo" 
                            name="costo" 
                            value="{{servicio.costo}}"
                            min="0" 
                            step="0.01"
                            placeholder="45000.00"
                            required
                        >
                        <span class="form-help">Solo números, permite hasta 2 decimales</span>
                    </div>

                    <!-- Vehículo Asignado (ya implementado) -->
                    <div class="form-group">
                        <label for="vehicle_id">Vehículo Asignado</label>
                        <select id="vehicle_id" name="vehicle_id" required>
                            <option value="">Seleccione un vehículo</option>
                            {{#each vehiculos}}
                                <option value="{{this.vehicle_id}}" {{#if (eq servicio.vehicle_id this.id)}}selected{{/if}}>
                                    {{this.placa}} - {{this.modelo}}
                                </option>
                            {{/each}}
                        </select>
                    </div>
                </div>
            </div>

            <!-- Descripción y Observaciones -->
            <div class="form-section">
                <h3 class="section-title">
                    <span class="section-icon">📝</span>
                    Detalles Adicionales
                </h3>
                
                <div class="form-grid full-width">
                    <div class="form-group">
                        <label for="descripcion">Descripción del Servicio</label>
                        <textarea 
                            id="descripcion" 
                            name="descripcion" 
                            rows="3"
                            placeholder="Descripción detallada del servicio a realizar..."
                        >{{servicio.descripcion}}</textarea>
                    </div>

                    <div class="form-group">
                        <label for="observaciones">Observaciones</label>
                        <textarea 
                            id="observaciones" 
                            name="observaciones" 
                            rows="3"
                            placeholder="Observaciones adicionales, notas especiales..."
                        >{{servicio.observaciones}}</textarea>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<script src="/js/viajesServices.js"></script>
