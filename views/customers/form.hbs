<!DOCTYPE html>
<html lang="es">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>{{titulo}} - Sistema de Clientes</title>
	<link rel="stylesheet" href="/clientes/form/form.css" />
</head>
<body>
	<div class="container">

		<div class="header">
			<h1>{{titulo}}</h1>
			<p>Complete todos los campos para {{#if cliente.customer_id}}actualizar{{else}}registrar{{/if}} el cliente.</p>
		</div>

		<form id="clienteForm" action="{{accion}}" method="POST" class="form-container">

			<fieldset class="form-section">
				<legend><span class="section-icon">👤</span> Información Personal</legend>
				<div class="form-grid">

					<div class="form-group">
						<label for="name" class="required">Nombre</label>
						<input type="text" id="name" name="name" value="{{cliente.name}}" required />
					</div>

					<div class="form-group">
						<label for="lastname" class="required">Apellido</label>
						<input type="text" id="lastname" name="lastname" value="{{cliente.lastname}}" required />
					</div>

					<div class="form-group">
						<label for="dui" class="required">DUI</label>
						<input type="text" id="dui" name="dui" value="{{cliente.dui}}" placeholder="00000000-0" required />
					</div>

					<div class="form-group">
						<label for="phone">Teléfono</label>
						<input type="text" id="phone" name="phone" value="{{cliente.phone}}" placeholder="0000-0000" />
					</div>

					<div class="form-group">
						<label for="email">Correo Electrónico</label>
						<input type="email" id="email" name="email" value="{{cliente.email}}" placeholder="correo@ejemplo.com" />
					</div>

					<div class="form-group form-full">
						<label for="location">Dirección</label>
						<textarea id="location" name="location" rows="2">{{cliente.location}}</textarea>
					</div>

				</div>
			</fieldset>

			<fieldset class="form-section">
				<legend><span class="section-icon">📄</span> Información Adicional</legend>
				<div class="form-grid">
					<div class="form-group form-full">
						<label for="comment">Observaciones</label>
						<textarea id="comment" name="comment" rows="3">{{cliente.comment}}</textarea>
					</div>

				</div>
			</fieldset>

			<!-- Botones de Acción -->
			<div class="form-actions">
				<button type="button" class="btn btn-secondary" id="goBackToList">
					<span class="btn-icon">←</span> Regresar
				</button>

				<button type="submit" class="btn btn-primary" id="submitBtn">
					<span class="btn-icon">💾</span>
					{{#if cliente.customer_id}}Actualizar Cliente{{else}}Guardar Cliente{{/if}}
				</button>
			</div>

			<script>
				document.addEventListener('DOMContentLoaded', function () {
					const goBackBtn = document.getElementById('goBackToList');
					if (goBackBtn) {
						goBackBtn.addEventListener('click', function () {
							window.location.href = 'http://localhost:3000/clientes/list/';
						});
					}
				});
			</script>

		</form>

		<!-- Modal de confirmación -->
		<div id="confirmModal" class="modal" style="display: none;">
			<div class="modal-content">
				<div class="modal-header">
					<h3>Confirmar Acción</h3>
					<span class="modal-close">&times;</span>
				</div>
				<div class="modal-body">
					<p id="confirmMessage">¿Está seguro de que desea guardar este cliente?</p>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" id="cancelConfirm">Cancelar</button>
					<button type="button" class="btn btn-primary" id="confirmSubmit">Confirmar</button>
				</div>
			</div>
		</div>

		<!-- Overlay de carga -->
		<div id="loadingOverlay" class="loading-overlay" style="display: none;">
			<div class="loading-spinner">
				<div class="spinner"></div>
				<p>Guardando cliente...</p>
			</div>
		</div>

	</div>

	<script src="/clientes/form/form.js"></script>
</body>
</html>
